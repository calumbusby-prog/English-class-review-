# Copy this file to .env for local development (never commit .env).
# In production (Render), set these as environment variables in the
# dashboard instead — see README.md.

# Option A: paste the whole service account JSON key as one line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Option B: the two fields that matter, separately (easier to paste into
# most dashboards). Keep the \n escapes in the private key as-is.
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleExampleExample\n-----END PRIVATE KEY-----\n"

# Maps class slugs (used in play.html?class=slug) to their content source.
# Each class needs EITHER "docId" (always use this one doc) OR "folderId"
# (auto-pick whichever doc in the folder was edited most recently).
CLASS_FOLDERS_JSON={"my-class":{"name":"My Class","docId":"PASTE_DOC_ID_HERE"}}

PORT=3000
