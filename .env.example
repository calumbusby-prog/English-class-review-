# Copy this file to .env for local development (never commit .env).
# In production (Render), set these as environment variables in the
# dashboard instead — see README.md.

# --- Content generation ---
# Lets an AI actually read each doc and write the exercises — finds the
# most recent dated section itself, and produces answers that are
# genuinely correct, instead of the free regex-based parser's best-effort
# guesses. Without either key below set, the server falls back to the
# free tag/heuristic parser (see parseContent.js) automatically —
# nothing breaks, it's just less smart. If BOTH are set, Claude is tried
# first, falling back to Gemini only if that call fails.

# Option A: Claude (paid, best quality). A few cents per doc, cached for
# 30 minutes.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the default model (claude-opus-5) — e.g. a cheaper
# one if cost matters more than quality for your use case.
# ANTHROPIC_MODEL=claude-opus-5

# Option B: Gemini (free tier, no card required). Get a key at
# https://aistudio.google.com/apikey — see README.md for the full
# walkthrough. Uses gemini-2.5-flash by default (permanent free tier:
# 500 requests/day, no expiring trial), cached for 30 minutes the same
# way. Quality is generally a bit behind Claude but far better than the
# regex parser, and genuinely free.
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# --- Google Drive access ---
# Option A (recommended if your docs are shared "Anyone with the
# link can view", which is the normal setup for a doc students already
# open) ---
# A plain Google API key, restricted to the Drive API. No service
# account, no private key file, no per-doc sharing step needed.
# GOOGLE_API_KEY=your-api-key-here

# --- Option B (for docs you'd rather keep private/un-public) ---
# A service account JSON key, as one line...
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# ...or just the two fields that matter (keep the \n escapes as-is):
# GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleExampleExample\n-----END PRIVATE KEY-----\n"

# Classes are normally configured in server/classes.json (committed to
# the repo, not secret — see that file). Only set CLASS_FOLDERS_JSON here
# if you want a class that ISN'T committed to the repo; same shape as
# classes.json, and entries here override same-slug entries from the file.
# CLASS_FOLDERS_JSON={"my-class":{"name":"My Class","docId":"PASTE_DOC_ID_HERE"}}

PORT=3000
